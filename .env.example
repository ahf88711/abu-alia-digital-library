ABU_ALIA_ENV=production
ABU_ALIA_SECRET_KEY=replace-with-a-long-random-string
ABU_ALIA_ADMIN_EMAIL=admin@example.com
ABU_ALIA_ADMIN_PASSWORD=replace-me
ABU_ALIA_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/abu_alia
ABU_ALIA_STORAGE_ROOT=/var/lib/abu-alia/storage
ABU_ALIA_PUBLIC_BASE_URL=https://example.com
ABU_ALIA_HARVEST_TARGET=4000
